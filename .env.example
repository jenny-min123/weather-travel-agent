# ============================================================
# weather-travel-agent —— 环境变量模板
# 用法：复制本文件为 .env，再填入真实值
#     cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
# 请勿把任何真实 Key / Token 写回本文件（本文件会被提交到仓库）。
#
# 命名约定：变量名与代码读取名【逐字符一致】，不支持别名。
# 代码侧统一读取位置：agents/_config.py
# ============================================================


# ------------------------------------------------------------
# 必填：模型网关（OpenAI 兼容协议）
# 代码读取位置：agents/chat/index.py
# ------------------------------------------------------------

# 模型网关 API Key
#   · 使用 Makers Models：控制台 → Makers → Models → API Key 新建
#   · 或填任意 OpenAI 兼容服务商的 Key
AI_GATEWAY_API_KEY=

# 模型网关 Base URL（注意结尾需带 /v1）
#   · Makers Models 固定为：https://ai-gateway.edgeone.link/v1
#   · 其他厂商填其 OpenAI 兼容端点，例如：https://api.openai.com/v1
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 可选：模型 ID（不填默认 @makers/deepseek-v4-flash，内置免费额度）
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash


# ------------------------------------------------------------
# 必填：高德地图 Web 服务（实时天气 / 地理编码 / 路径规划）
# 申请入口：https://console.amap.com/dev/key/app
# 账号类型需为「Web服务」，不要用 JS API / iOS / Android 类型的 Key。
# 代码读取位置：agents/_config.py → amap_weather_key() / amap_route_key()
# ------------------------------------------------------------

# 实时天气（get_weather、get_travel_advice 使用）
AMAP_WEATHER_API_KEY=

# 路径规划 / 地理编码（阶段二「沿途天气」使用）
AMAP_ROUTE_API_KEY=

# 通用 Key。当上面两个为空时作为兜底；留空即可。
AMAP_API_KEY=


# ------------------------------------------------------------
# 必填：默认城市（用户说「我这 / 当前位置」时会用它兜底）
# 代码读取位置：agents/_config.py → default_city()
# ------------------------------------------------------------
DEFAULT_CITY=北京


# ------------------------------------------------------------
# 可选：逐小时预报（和风天气 QWeather）
# 控制台：https://console.qweather.com/
# 代码读取位置：agents/_config.py → qweather_*()
# 留空时 get_hourly_forecast 返回 available=false，主流程不受影响。
# ------------------------------------------------------------

# 逐小时预报提供方，目前仅支持 qweather
HOURLY_FORECAST_PROVIDER=qweather

# 和风天气 API Key
QWEATHER_API_KEY=

# 和风天气专属 API Host —— 填【裸域名】，不要带 https://
# 形如：abcdefg.re.qweatherapi.com（控制台「设置 → API Host」中查看）
QWEATHER_API_HOST=


# ------------------------------------------------------------
# 可选（阶段二已实现）：沿途天气采样
# 代码读取位置：agents/_config.py → route_weather_enabled() /
#               route_sample_points()
#               编排逻辑：agents/_route.py
# 关闭后 get_route_weather 会直接返回 ROUTE_WEATHER_DISABLED，不发起任何请求。
# ------------------------------------------------------------

# 是否启用沿途天气采样：true / false
ROUTE_WEATHER_ENABLED=true

# 路径上采样点数量，取值 2–10，越界会被夹紧
ROUTE_WEATHER_SAMPLE_POINTS=4

# ------------------------------------------------------------
# 可选（阶段三已实现）：到达时刻时间对齐
# 代码读取位置：agents/_config.py → route_forecast_enabled() /
#               route_forecast_tolerance_min()
#               纯函数：agents/_timealign.py
# 开启后每个采样点会按「出发时刻 + 分段累计耗时」推算到达时刻，
# 再取该时刻的逐小时预报；超范围则逐层升级 24h → 72h → 168h → 7d，
# 仍无覆盖则该点回落当前实况，并标注 fallback_to_live。
# ------------------------------------------------------------

# 是否启用时间对齐：false 可一键回到阶段二行为（各点只报当前实况）
ROUTE_FORECAST_ENABLED=true

# 预报整点与到达时刻的最大允许偏差（分钟），取值 30–180；
# 超出即升级到更宽的预报层
ROUTE_FORECAST_TOLERANCE_MIN=90


# ------------------------------------------------------------
# 说明：以下变量不属于本项目运行所需，请不要写在本文件里
# ------------------------------------------------------------
# EDGEONE_API_TOKEN
#   仅用于 GitHub Actions 自动部署到 EdgeOne Makers，
#   应配置在 GitHub 仓库的 Settings → Secrets and variables → Actions，
#   不要放进 .env、也不要提交到仓库。
#   详见 DEPLOY_EDGEONE_MAKERS.md
